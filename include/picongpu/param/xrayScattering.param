#pragma once

#include "picongpu/plugins/externalBeam/Side.def"
#include "picongpu/unitless/precision.unitless"

/* preprocessor struct generator */
#include <pmacc/preprocessor/struct.hpp>

namespace picongpu
{
    namespace plugins
    {
        namespace xrayScattering
        {
            namespace beam
            {
                using namespace picongpu::plugins::externalBeam;
                /* Choose from:
                 *  - ZSide
                 *  - YSide
                 *  - XSide
                 * - ZRSide
                 * - YRSide
                 * - XRSide
                 */
                using ProbingSide = picongpu::plugins::externalBeam::ZSide;

                PMACC_STRUCT(
                    RotationParam,
                    (PMACC_C_VALUE(float_X, yawAngle, 0))(PMACC_C_VALUE(float_X, pitchAngle, 0)));

                constexpr float_X BEAM_OFFSET[2] = {0.0, 0.0};
                constexpr float_X BEAM_DELAY_SI = 0.0;
                using BeamProfile = externalBeam::beamProfiles::ConstProfile;
                using BeamShape = externalBeam::beamShapes::ConstShape<>;

                using BeamCoordinates = picongpu::plugins::externalBeam::CoordinateTransform<
                    ProbingSide,
                    picongpu::plugins::externalBeam::SecondaryRotation<RotationParam>>;
                using XrayScatteringBeam
                    = picongpu::plugins::externalBeam::ProbingBeam<BeamProfile, BeamShape, BeamCoordinates>;
            } // namespace beam
        } // namespace xrayScattering
    } // namespace plugins
} // namespace picongpu
