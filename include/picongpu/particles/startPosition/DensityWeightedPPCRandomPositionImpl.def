#pragma once

#include "picongpu/defines.hpp"
#include "picongpu/particles/startPosition/generic/FreeRng.def"

#include <pmacc/random/distributions/Uniform.hpp>

#include <boost/mpl/integral_c.hpp>

namespace picongpu
{
    namespace particles
    {
        namespace startPosition
        {
            namespace acc
            {
                /** Set the in cell position randomly with density weighted number of particles per cell.
                 *
                 * @see startPosition::DensityWeightedPPCRandomPositionImpl
                 *
                 * @tparam T_ParamClass parameter class, must define ::particlesPerBaseDensity
                 */
                template<typename T_ParamClass>
                struct DensityWeightedPPCRandomPositionImpl;

            } // namespace acc

            /** Set the in cell position randomly with density weighted number of particles per cell.
             *
             * The new position is uniformly distributed inside the cell.
             * The number of particles per cells is ceil((cellDensity/ baseDensity) * particlesPerBaseDensity).
             * This means at least 1 particle per cell, but not if the weighting would fall below the minimal
             * weighting.
             *
             * @tparam T_ParamClass parameter class, must define ::particlesPerBaseDensity
             */
            template<typename T_ParamClass>
            using DensityWeightedPPCRandomPositionImpl = generic::FreeRng<
                acc::DensityWeightedPPCRandomPositionImpl<T_ParamClass>,
                pmacc::random::distributions::Uniform<float_X>>;
        } // namespace startPosition
    } // namespace particles
} // namespace picongpu
