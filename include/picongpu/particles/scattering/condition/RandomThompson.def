#pragma once

#include "picongpu/particles/scattering/generic/FreeRng.def"

namespace picongpu
{
    namespace particles
    {
        namespace scattering
        {
            namespace condition
            {
                namespace acc
                {
                    /* Scattering probability from a total cross section
                     *
                     * The probability is the distance a particle travels in one step
                     * over the free path length(sigma * n). Sigma is the total cross section.
                     *
                     * @tparam T_ParamClass param class providing the total cross section.
                     *      Example:
                     *      @code{c++}
                     *      struct Param
                     *      {
                     *          // Thompson scattering total cross section
                     *          // unit is m^{-2}
                     *          static constexpr float_64 totalCrossSection = 6.65e-29;
                     *      };
                     *
                     */
                    template<typename T_ParamClass, uint32_t maxScattering>
                    struct RandomThompson;
                } // namespace acc

                template<typename T_ParamClass, uint32_t maxScattering = 0>
                using RandomThompson = picongpu::particles::scattering::generic::FreeRng<
                    acc::RandomThompson<T_ParamClass, maxScattering>,
                    pmacc::random::distributions::Uniform<float_X>>;
            } // namespace condition
        } // namespace scattering
    } // namespace particles
} // namespace picongpu
