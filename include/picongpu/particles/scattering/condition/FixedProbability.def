#pragma once

#include "picongpu/particles/scattering/generic/FreeRng.def"

namespace picongpu
{
    namespace particles
    {
        namespace scattering
        {
            namespace condition
            {
                namespace acc
                {
                    /* Scatter with a fixed probability within one time step
                     *
                     *
                     * @tparam T_ParamClass param class providing the probability.
                     *      Example:
                     *      @code{c++}
                     *      struct Param
                     *      {
                     *          static constexpr float_X probability = 0.1_X;
                     *      };
                     *
                     */
                    template<typename T_ParamClass, uint32_t maxScattering>
                    struct FixedProbability;
                } // namespace acc

                template<typename T_ParamClass, uint32_t maxScattering = 0>
                using FixedProbability = picongpu::particles::scattering::generic::FreeRng<
                    acc::FixedProbability<T_ParamClass, maxScattering>,
                    pmacc::random::distributions::Uniform<float_X>>;
            } // namespace condition
        } // namespace scattering
    } // namespace particles
} // namespace picongpu
