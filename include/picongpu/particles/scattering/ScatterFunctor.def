#pragma once

#include "picongpu/simulation_defines.hpp"
namespace picongpu
{
    namespace particles
    {
        namespace scattering
        {
            /* Host side scattering functor
             *
             *  Creates the device side functor which scatters a particle if the condtions functor returns true.
             *  The scattering itself is done by the direction functor.
             *
             *  @tparam T_ConditionFunctor
             *  @tparam T_DirectionFunctor
             */
            template<
                typename T_DensityFields,
                typename T_ConditionFunctor,
                typename T_DirectionFunctor,
                typename T_ReferenceDistance = void>
            struct ScatterFunctor;
        } // namespace scattering
    } // namespace particles
} // namespace picongpu
