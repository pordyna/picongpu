#pragma once

#include "picongpu/simulation_defines.hpp"

#include "picongpu/particles/scattering/generic/FreeRng.def"

namespace picongpu
{
    namespace particles
    {
        namespace scattering
        {
            namespace direction
            {
                namespace acc
                {
                    /* Scatter particles in a random direction
                     *
                     * Particles are uniformly scattered in a cone defined by the minimal and maximal polar angle.
                     * @tparam T_ParamClass param class with the polar angle limits
                     *      Example:
                     *       struct DirectionParam
                     *       {
                     *          // unit are radians
                     *          static constexpr float_64 maxPolarAngle = 0.05;
                     *          static constexpr float_64 minPolarAngle = 0.0;
                     *       };
                     * @tparam alwaysInLimits if true the inLimits method will always return true if false this method
                     *      will return true with a probability equal to the total probability of being scattered
                     *      within the limits defined in the param class (assuming the Thompson scattering angular
                     *      distribution).
                     */
                    template<typename T_Rng_precision>
                    struct RandomThompson;
                } // namespace acc

                // TODO make the distribution precission an option
                template<typename T_Rng_precision = float_64>
                using RandomThompson = picongpu::particles::scattering::generic::FreeRng<
                    acc::RandomThompson<T_Rng_precision>,
                    pmacc::random::distributions::Uniform<T_Rng_precision>>;
            } // namespace direction
        } // namespace scattering
    } // namespace particles
} // namespace picongpu
