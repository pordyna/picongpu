#pragma once

#include "picongpu/simulation_defines.hpp"

#include "picongpu/particles/traits/SpeciesEligibleForSolver.hpp"
#include "picongpu/plugins/photonDetector/DetectorParams.def"

#include <pmacc/traits/HasIdentifiers.hpp>

namespace picongpu
{
    namespace plugins
    {
        namespace photonDetector
        {
            namespace accumulation
            {
                namespace acc
                {
                    template<typename T_Species>
                    struct CountMacroParticles;
                } // namespace acc

                /** Functor factory (host side functor) for the CountMacroParticles device accumulation functor
                 *
                 * @tparam T_Species type of the particle species accumulated on the detector
                 */
                template<typename T_Species>
                struct CountMacroParticles;
            } // namespace accumulation
            namespace particleHandlers
            {
                /** Simply count macro particles hitting a detector cell.
                 *
                 * A particle accumulation policy for a particle detector.
                 */
                struct CountMacroParticles
                {
                    //! Get a functor factory type for a give particle species type
                    template<typename T_Species>
                    struct apply
                    {
                        using type = picongpu::plugins::photonDetector::accumulation::CountMacroParticles<T_Species>;
                    };
                };
            } // namespace particleHandlers
        } // namespace photonDetector
    } // namespace plugins
} // namespace picongpu
