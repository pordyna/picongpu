#pragma once

#include "picongpu/simulation_defines.hpp"

#include "picongpu/plugins/photonDetector/accumulation/accumulationPolicies.def"

#ifndef PARAM_DET_CELL
#    define PARAM_DET_CELL 20.0
#endif

namespace picongpu
{
    namespace plugins
    {
        namespace photonDetector
        {
            struct PhotonDetectorConfig1
            {
                using AccumulationPolicy =
                    /**g
                     * Policy that defines how the detector handles incoming particles
                     * Possible values:
                     *  - particleHandlers::CountParticles
                     *  - particleHandlers::AddWaveParticles
                     */
                    particleHandlers::AddWaveParticles;
                using ParticleFilter = particles::filter::Scattered;

                /**
                 * Distance of the detector from the right side of the volume
                 * Unit: meter
                 */
                static constexpr float_64 distance = 1.0;
                /**
                 * Width and height of each detector cell
                 * Unit: meter
                 */
                static constexpr float_64 cellWidth = PARAM_DET_CELL * 1.0e-6;
                static constexpr float_64 cellHeight = PARAM_DET_CELL * 1.0e-6;

                static std::string getName()
                {
                    return "AddWaveParticlesCfg";
                }
            };
            constexpr float_64 PhotonDetectorConfig1::distance;
            constexpr float_64 PhotonDetectorConfig1::cellWidth;
            constexpr float_64 PhotonDetectorConfig1::cellHeight;

            struct PhotonDetectorConfig2
            {
                using AccumulationPolicy =
                    /**g
                     * Policy that defines how the detector handles incoming particles
                     * Possible values:
                     *  - particleHandlers::CountParticles
                     *  - particleHandlers::AddWaveParticles
                     */
                    particleHandlers::CountParticles;
                using ParticleFilter = particles::filter::Scattered;

                /**
                 * Distance of the detector from the right side of the volume
                 * Unit: meter
                 */
                static constexpr float_64 distance = 1.0;
                /**
                 * Width and height of each detector cell
                 * Unit: meter
                 */
                static constexpr float_64 cellWidth = PARAM_DET_CELL * 1.0e-6;
                static constexpr float_64 cellHeight = PARAM_DET_CELL * 1.0e-6;

                static std::string getName()
                {
                    return "CountParticlesCfg";
                }
            };
            constexpr float_64 PhotonDetectorConfig2::distance;
            constexpr float_64 PhotonDetectorConfig2::cellWidth;
            constexpr float_64 PhotonDetectorConfig2::cellHeight;

            using SeqAllDetectorConfigs = MakeSeq_t<PhotonDetectorConfig1, PhotonDetectorConfig2>;
        } // namespace photonDetector
    } // namespace plugins
} // namespace picongpu
