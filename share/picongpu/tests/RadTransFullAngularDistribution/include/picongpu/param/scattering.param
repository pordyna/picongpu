#pragma once

#include "picongpu/simulation_defines.hpp"

#include "picongpu/particles/scattering/functors.def"
/* preprocessor struct generator */
#include <pmacc/preprocessor/struct.hpp>

#ifndef PARAM_MAX_POLAR_ANGLE
#    define PARAM_MAX_POLAR_ANGLE 1.0
#endif
namespace picongpu
{
    namespace particles
    {
        namespace scattering
        {
            using ConditionFunctor = condition::Always<1u>;
            using DirectionFunctor = direction::RandomThompson;

            template<typename T_Densities>
            using PhotonScatterer
                = ScatterFunctor<T_Densities, ConditionFunctor, DirectionFunctor, notInLimits::DoNothing>;
        } // namespace scattering
    } // namespace particles
} // namespace picongpu
