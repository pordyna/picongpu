#pragma once

#include "picongpu/simulation_defines.hpp"

#include "picongpu/particles/scattering/functors.def"
/* preprocessor struct generator */
#include <pmacc/preprocessor/struct.hpp>

#ifndef PARAM_NEW_PARTICLES_ON_SPLIT
#    define PARAM_NEW_PARTICLES_ON_SPLIT 11u
#endif

#ifndef PARAM_PHOTON_SCATTERER
#    define PARAM_PHOTON_SCATTERER PhotonScattererSimple
#endif

namespace picongpu
{
    namespace particles
    {
        namespace scattering
        {
            struct ConditionParam
            {
                static constexpr float_64 threshold = 0.1 / UNIT_LENGTH / UNIT_LENGTH / UNIT_LENGTH;
            };

            struct DirectionParam
            {
                static constexpr float_64 maxPolarAngle = 0.03; // all should hit the detector
                static constexpr float_64 minPolarAngle = 0.0;
            };
            using ConditionFunctorThresholdSingle = condition::Threshold<ConditionParam, 1u>;
            using DirectionFunctorUniform = direction::Random<DirectionParam>;

            using ConditionFunctor = ConditionFunctorThresholdSingle;
            using DirectionFunctor = DirectionFunctorUniform;

            template<typename T_Densities>
            using PhotonScattererSplit = SplitScatterer<
                T_Densities,
                ConditionFunctor,
                splitCondition::Always,
                DirectionFunctor,
                PARAM_NEW_PARTICLES_ON_SPLIT>;

            template<typename T_Densities>
            using PhotonScattererSimple
                = ScatterFunctor<T_Densities, ConditionFunctor, DirectionFunctor>;

            template<typename T_Densities>
            using PhotonScatterer = PARAM_PHOTON_SCATTERER<T_Densities>;

        } // namespace scattering
    } // namespace particles
} // namespace picongpu
