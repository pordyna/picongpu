#pragma once

#include "picongpu/simulation_defines.hpp"

#include "picongpu/particles/scattering/functors.def"
/* preprocessor struct generator */
#include <pmacc/preprocessor/struct.hpp>

#ifndef PARAM_MAX_POLAR_ANGLE
#    define PARAM_MAX_POLAR_ANGLE 1.0
#endif
namespace picongpu
{
    namespace particles
    {
        namespace scattering
        {
            struct ConditionParam
            {
                static constexpr float_X probability = 0.05_X;
            };
            struct DirectionParam
            {
                static constexpr float_64 maxPolarAngle = PARAM_MAX_POLAR_ANGLE; // all should hit the detector
                static constexpr float_64 minPolarAngle = 0.0;
            };
            using ConditionFunctor = condition::FixedProbability<ConditionParam, 5u>;
            using DirectionFunctor = direction::Random<DirectionParam, true>;

            template<typename T_Densities>
            using PhotonScatterer = SplitScatterer<
                T_Densities,
                ConditionFunctor,
                splitCondition::GenerationLimit<3u>,
                DirectionFunctor,
                3u>;
        } // namespace scattering
    } // namespace particles
} // namespace picongpu
